QMainWindow {
    background-color: #f8f9fa;
    color: #212529;
}

QWidget {
    color: #212529;
}

QLabel#labelTitle {
    font-size: 20px;
    font-weight: bold;
    color: #2c3e50;
    padding: 10px;
}

QLabel#labelResultsHeader {
    font-size: 16px;
    font-weight: bold;
    color: #34495e;
    margin-bottom: 10px;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #ced4da;
    border-radius: 6px;
    margin-top: 1.1em;
    padding-top: 10px;
    background-color: #ffffff;
    color: #212529;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 3px;
    color: #495057;
}

QLineEdit {
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px;
    background-color: #ffffff;
    color: #212529;
    selection-background-color: #007bff;
}

QLineEdit:focus {
    border-color: #80bdff;
}

QPushButton#pushButtonCalculate {
    background-color: #007bff;
    color: white;
    border-radius: 5px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#pushButtonCalculate:hover {
    background-color: #0069d9;
}

QPushButton#pushButtonClear {
    background-color: #6c757d;
    color: white;
    border-radius: 5px;
    font-weight: bold;
    font-size: 14px;
}

QFrame#frameResults {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 15px;
}

QLabel[objectName$="_val"] {
    font-weight: bold;
    color: #007bff;
}

QTextEdit#textEditLog {
    border: 1px solid #e9ecef;
    background-color: #f8f9fa;
    color: #212529;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 11px;
}

QStatusBar {
    background-color: #f8f9fa;
    color: #212529;
}

/* Menu Bar */
QMenuBar {
    background-color: #f3f3f3;
    color: #1e1e1e;
    border-bottom: 1px solid #cccccc;
}
QMenuBar::item:selected {
    background-color: #dcdcdc;
}

/* Dropdown Menus */
QMenu {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #b3b3b3;
}
QMenu::item:selected {
    background-color: #0078d7; /* Standard highlight blue */
    color: #ffffff;
}

/* Status Bar (at the bottom) */
QStatusBar {
    background-color: #f3f3f3;
    color: #1e1e1e;
}